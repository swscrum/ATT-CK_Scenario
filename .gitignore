########################
# General
########################
# PDF builds — generated from Typst source, not tracked
intern/Dokumentation/main.pdf
*.env
*.env.*
/.*ignore*
*/isos/*.iso
.claude

# Recon scan output + attack-chain ground-truth JSON
Attack-chain/results/*
!Attack-chain/results/.gitkeep

# Container logs (runtime artifacts; persisted via docker-compose volumes)
Infrastructure/logs/**/*
!Infrastructure/logs/**/.gitkeep

# Runtime drop from the advanced T1505.003 persistence step.
# advanced_webserver_persistence.py uploads payloads/health_check.cgi into
# /usr/local/apache2/cgi-bin/ via Sliver; because that directory is bind-
# mounted to ./apache/cgi-bin on the host, the runtime drop persists into
# the working tree. Tracking it would defeat the persistence semantics
# (the chain would "drop" a file that already exists at build time).
Infrastructure/apache/cgi-bin/health_check.cgi

# Python bytecode
__pycache__/
*.pyc
Attack-chain/__pycache__/

########################
# macOS
########################
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Time Machine
.DocumentRevisions-V100
.TemporaryItems
.fseventsd

# Disk images
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# AFP shares
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk


########################
# Windows
########################
# Windows image file caches
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk


########################
# Linux / Unix
########################
# Temporary files
*~

# KDE & other desktop helpers
.directory

# Trash folders
.Trash-*

# NFS files
.nfs*


########################
# JS / Node (workstation lab projects)
########################
**/node_modules/
**/.vite/

# Workstation-Build (identisch zu Infrastructure/html/, das die produktive Quelle ist)
Infrastructure/ubuntu_workstation/john_home/projects/waystar-connect/dist/

# npm/yarn/pnpm debug logs (NICHT *.log global — Lab nutzt .log als Artefakt)
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Lab internal CA private key — generated by tools/generate-lab-ca.sh,
# only ever needs to live on the dev host; the .crt IS committed so
# workstation images can install it as a trusted CA.
Infrastructure/shared-lab-keys/lab-ca.key

# CA serial file — written by openssl's -CAcreateserial each time a cert is
# signed. Pure build artifact, changes on every signing; do not track.
Infrastructure/shared-lab-keys/lab-ca.srl

# fake_internet TLS key + cert — auto-generated by tools/generate-lab-ca.sh
# if missing (signed by the lab CA). Both are local artifacts: the cert is
# re-derivable from the committed CA, so it does not need to be tracked.
Infrastructure/fake_internet/ssl/server.key
Infrastructure/fake_internet/ssl/server.crt
