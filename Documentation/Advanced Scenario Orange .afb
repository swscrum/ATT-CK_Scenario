{
    "schema": "attack_flow_v2",
    "theme": "dark_theme",
    "objects": [
        {
            "id": "flow",
            "instance": "c1bd9120-24c3-4e61-af07-f1efc19cb9f8",
            "properties": [
                [
                    "name",
                    "Advanced Scenario Orange "
                ],
                [
                    "description",
                    "The Waystar Royco Advanced Scenario is an APT-paced kill chain that gains a foothold by\n  exploiting CVE-2021-41773, an Apache httpd 2.4.49 path-traversal flaw that yields remote code\n  execution via mod_cgi, then reflectively loads an in-memory Sliver implant that beacons out\n  over HTTPS C2. After escalating to root through a cap_setuid binary and planting a\n  health_check.cgi web shell for resilient re-entry, the operator pivots to the sysadmin\n  workstation vinzenz_ws by hijacking a forwarded SSH-agent session under cover of an\n  application-exhaustion DoS, and phishes root by appending a malicious sudo() function to the\n  admin's ~/.bashrc. It then exfiltrates the Waystar patient database over the Sliver C2 channel\n  and performs selective, low-signature cleanup — grep-filtered logs, rotated command history,\n  false-flag artefacts, and an authorized_keys backdoor — before ransomware-style impact and an\n  optional restoration phase, with long dwell times throughout to emulate a patient, targeted\n  adversary."
                ],
                [
                    "author",
                    [
