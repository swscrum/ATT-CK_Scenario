{
    "schema": "attack_flow_v2",
    "theme": "dark_theme",
    "objects": [
        {
            "id": "flow",
            "instance": "da8e3ef9-f833-4907-8ffe-9759365c9f51",
            "properties": [
                [
                    "name",
                    "Basic Scenario Orange"
                ],
                [
                    "description",
                    "The Waystar Royco Basic Scenario is a full seven-phase kill\n  chain that begins by exploiting CVE-2021-41773, an Apache httpd\n  2.4.49 path-traversal flaw that grants remote code execution\n  via mod_cgi on the internet-facing web server. After landing a\n  reverse shell, the attacker abuses a world-writable root cron\n  script (/opt/cleanup.sh) to escalate to root, harvests reused\n  credentials to move laterally onto an internal workstation, and\n  finishes by exfiltrating the Waystar patient database over\n  plain HTTP before wiping logs to cover its tracks."
                ],
                [
                    "author",
                    [
                        [
                            "name",
                            "ATT-CK Scenario Team"
                        ],
                        [
