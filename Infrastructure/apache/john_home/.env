# waystar-connect dev env — sourced by deploy/test helpers.
# (vibecoded helper; meant to be removed before go-live, never was.)

# Project metadata
APP_NAME=waystar-connect
APP_VERSION=0.4.2
NODE_ENV=development

# Workstation deploy box (where `npm run deploy` rsyncs FROM)
WS_HOST=10.30.0.5
WS_USER=john.stravidis
# Same interim password the transition team set on the workstation account.
# Used by the non-interactive rsync helper when the SSH agent isn't loaded.
WS_PASS=waystar2026!

# Apache deploy target (where rsync pushes TO)
DEPLOY_HOST=apache
DEPLOY_PATH=/opt/waystar-connect/dist/
