\dt
\d session_notes
\d patients
SELECT count(*) FROM session_notes WHERE therapist = 'Luke Smith';
SELECT id, patient_id, session_date, session_type FROM session_notes WHERE therapist = 'Luke Smith' ORDER BY session_date DESC LIMIT 10;
SELECT * FROM session_notes WHERE therapist = 'Luke Smith' AND patient_id = 1041 ORDER BY session_date DESC LIMIT 5;
SELECT id, patient_id, session_date FROM session_notes WHERE therapist = 'Luke Smith' AND session_date >= '2026-05-01' ORDER BY session_date DESC;
SELECT first_name, last_name FROM patients WHERE id IN (SELECT DISTINCT patient_id FROM session_notes WHERE therapist = 'Luke Smith');
SELECT session_type, count(*) FROM session_notes WHERE therapist = 'Luke Smith' GROUP BY session_type;
\q
