<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pre-configured panel that only references plugins shipped with the base
  xfce4 install. The Ubuntu 24.04 default panel template includes:

    (null)                  — xfce4-statusnotifier-plugin (not installed)
    power-manager-plugin    — xfce4-power-manager (not installed)
    notification-plugin     — xfce4-notifyd (not installed)

  These appear in docker logs as "plugin was not found and has been removed"
  messages and trigger libnotify / libclock proxy warnings from their
  wrapper processes. This file replaces them with a clean layout built
  entirely from xfce4-panel's built-in plugins.
-->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
  </property>

  <property name="panel-1" type="empty">
    <property name="position"        type="string" value="p=0;x=100;y=30"/>
    <property name="length"          type="uint"   value="100"/>
    <property name="position-locked" type="bool"   value="false"/>
    <property name="size"            type="uint"   value="28"/>
    <property name="plugin-ids"      type="array">
      <value type="int" value="1"/>
      <value type="int" value="2"/>
      <value type="int" value="3"/>
      <value type="int" value="4"/>
      <value type="int" value="5"/>
      <value type="int" value="6"/>
      <value type="int" value="7"/>
    </property>
  </property>

  <property name="plugins" type="empty">
    <!-- App launcher -->
    <property name="plugin-1" type="string" value="applicationsmenu"/>
    <!-- Fixed separator -->
    <property name="plugin-2" type="string" value="separator"/>
    <!-- Window buttons -->
    <property name="plugin-3" type="string" value="tasklist">
      <property name="grouping" type="uint" value="0"/>
    </property>
    <!-- Expanding spacer — pushes systray/clock to the right -->
    <property name="plugin-4" type="string" value="separator">
      <property name="expand" type="bool"  value="true"/>
      <property name="style"  type="uint"  value="0"/>
    </property>
    <!-- Legacy system tray (no xfce4-statusnotifier-plugin needed) -->
    <property name="plugin-5" type="string" value="systray"/>
    <!-- Clock (libclock; logind stub provides org.freedesktop.login1) -->
    <property name="plugin-6" type="string" value="clock"/>
    <!-- Show-desktop button -->
    <property name="plugin-7" type="string" value="showdesktop"/>
  </property>
</channel>
