\dt
\d patients
\d session_notes
\d appointments
SELECT count(*) FROM patients;
SELECT count(*) FROM session_notes;
SELECT count(*) FROM appointments;
SELECT * FROM appointments ORDER BY created_at DESC LIMIT 5;
SELECT focus, count(*) FROM appointments GROUP BY focus;
SELECT date_trunc('week', created_at), count(*) FROM appointments GROUP BY 1 ORDER BY 1 DESC LIMIT 8;
\? appointments
\q
