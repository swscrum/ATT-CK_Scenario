Host apache
    HostName apache
    User john.stravidis
    IdentityFile ~/.ssh/id_ed25519
    StrictHostKeyChecking accept-new

# Internal hosts — tried a few times during onboarding to see what I could
# reach with my deploy key. Only apache is in scope for my role; the IT team
# said the rest are key-only and centrally managed.
#
# Lab note: when the real hardened-ws-{1,2} containers ship, refresh the
# matching ~/.ssh/known_hosts entries — the placeholders there would
# otherwise trigger "REMOTE HOST IDENTIFICATION HAS CHANGED".
Host hardened-ws-1
    HostName hardened-ws-1
    User john.stravidis
    IdentityFile ~/.ssh/id_ed25519

Host hardened-ws-2
    HostName hardened-ws-2
    User john.stravidis
    IdentityFile ~/.ssh/id_ed25519

Host *
    ServerAliveInterval 30
    ServerAliveCountMax 3
