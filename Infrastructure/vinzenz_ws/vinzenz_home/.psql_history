\l+
\dt
\du
\dn
\d patients
\d session_notes
\d appointments
SELECT version();
SELECT current_database(), current_user;
SELECT count(*) FROM patients;
SELECT count(*) FROM session_notes;
SELECT count(*) FROM appointments;
SELECT pg_size_pretty(pg_database_size('waystar'));
SELECT pg_size_pretty(pg_total_relation_size('patients'));
SELECT pg_size_pretty(pg_total_relation_size('session_notes'));
SELECT pid, usename, application_name, client_addr, state, query_start FROM pg_stat_activity WHERE state != 'idle';
SELECT pid, usename, application_name, client_addr FROM pg_stat_activity;
SELECT locktype, relation::regclass, mode, granted, pid FROM pg_locks WHERE NOT granted;
SELECT schemaname, tablename, n_live_tup, n_dead_tup FROM pg_stat_user_tables;
SELECT relname, n_dead_tup, last_vacuum, last_autovacuum FROM pg_stat_user_tables WHERE n_dead_tup > 1000;
VACUUM ANALYZE appointments;
VACUUM ANALYZE session_notes;
ANALYZE patients;
REINDEX TABLE appointments;
SHOW statement_timeout;
SHOW log_statement;
SHOW shared_buffers;
SELECT * FROM pg_stat_database WHERE datname = 'waystar';
SELECT rolname, rolsuper, rolcreaterole, rolcreatedb FROM pg_roles;
GRANT CONNECT ON DATABASE waystar TO "waystar-readonly";
ALTER ROLE "waystar-readonly" SET statement_timeout = '30s';
\q
