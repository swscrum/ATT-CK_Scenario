-- vinzenz.fedora's psqlrc (sysadmin)
-- Loaded by psql on startup. See `psql --help` for what these do.

\set QUIET 1

-- Sysadmin prompt: user@host:db [txn-status]>
\set PROMPT1 '%[%033[1;31m%]%n@%M:%/%[%033[0m%]%R%# '
\set PROMPT2 '%[%033[1;31m%]%/%R%[%033[0m%]%# '

-- Show timing for every query.
\timing on

-- Friendlier null display.
\pset null '∅'

-- Verbose error output (full DETAIL/HINT/CONTEXT lines).
\set VERBOSITY verbose

-- Long lines wrap at terminal width.
\pset format wrapped

-- Saved queries — set up as one-shot variables for common admin checks.
\set conns 'SELECT pid, usename, application_name, client_addr, state, query_start FROM pg_stat_activity WHERE state != \'idle\';'
\set sizes 'SELECT relname, pg_size_pretty(pg_total_relation_size(c.oid)) AS total FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind = \'r\' AND n.nspname = \'public\' ORDER BY pg_total_relation_size(c.oid) DESC;'
\set locks 'SELECT locktype, relation::regclass, mode, granted, pid FROM pg_locks WHERE NOT granted;'
\set vacuums 'SELECT relname, n_dead_tup, last_vacuum, last_autovacuum FROM pg_stat_user_tables WHERE n_dead_tup > 1000 ORDER BY n_dead_tup DESC;'

-- Patient-data counts (used during weekly health-checks).
\set patient_counts 'SELECT (SELECT count(*) FROM patients) AS patients, (SELECT count(*) FROM session_notes) AS notes, (SELECT count(*) FROM appointments) AS appts;'

\set QUIET 0
\echo 'Loaded ~/.psqlrc — :conns :sizes :locks :vacuums :patient_counts available'
